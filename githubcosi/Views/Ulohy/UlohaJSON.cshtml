<script>
const workersJson = `[
    {"name":"Alice", "age":30, "position":"programmer"},
    {"name":"Bob", "age":25, "position":"programmer"},
    {"name":"Charlie", "age":35, "position":"manager"},
    {"name":"Diana", "age":28, "position":"designer"},
    {"name":"Eve", "age":32, "position":"programmer"},
    {"name":"Frank", "age":29, "position":"designer"},
    {"name":"Grace", "age":27, "position":"programmer"}
]`;

const workers = JSON.parse(workersJson);

const programmers = workers.filter(worker => worker.position === "programmer");

console.log("Programmers:");
programmers.forEach(prog => {
    console.log(prog.name + ", Age: " + prog.age);
});
</script>



<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Workers Table</title>

</head>
<body>

<table id="workersTable">
    <thead>
        <tr><th>Name</th><th>Age</th><th>Position</th></tr>
    </thead>
    <tbody></tbody>
</table>

<script>
const workersson = `[
    {"name":"Alice", "age":30, "position":"programmer"},
    {"name":"Bob", "age":25, "position":"programmer"},
    {"name":"Charlie", "age":35, "position":"manager"},
    {"name":"Diana", "age":28, "position":"designer"},
    {"name":"Eve", "age":32, "position":"programmer"},
    {"name":"Frank", "age":29, "position":"designer"},
    {"name":"Grace", "age":27, "position":"programmer"}
]`;

const worker = JSON.parse(workersson);
let rows = "";

for(let i = 0; i < worker.length; i++) {
    rows += `<tr>
        <td>${worker[i].name}</td>
        <td>${worker[i].age}</td>
        <td>${worker[i].position}</td>
    </tr>`;
}

document.querySelector("#workersTable tbody").innerHTML = rows;
</script>

</body>

<style>
    table { border-collapse: collapse; width: 50%; margin-top: 20px; }
    th, td { border: 1px solid #000; padding: 8px; text-align: left; }
    th { background-color: #f2f2f2; }
</style>    
</html>

